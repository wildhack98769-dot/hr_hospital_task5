<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_hr_hospital_visit_patient_own" model="ir.rule">
            <field name="name">Hospital Visits: Patient Own Visits</field>
            <field name="model_id" ref="model_hr_hospital_visit"/>
            <field name="domain_force">[('patient_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('hr_hospital.group_hospital_patient'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hr_hospital_visit_intern_own" model="ir.rule">
            <field name="name">Hospital Visits: Intern Own Visits</field>
            <field name="model_id" ref="model_hr_hospital_visit"/>
            <field name="domain_force">[('doctor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('hr_hospital.group_hospital_intern'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hr_hospital_visit_doctor_team" model="ir.rule">
            <field name="name">Hospital Visits: Doctor and Intern Team Visits</field>
            <field name="model_id" ref="model_hr_hospital_visit"/>
            <field name="domain_force">['|', ('doctor_id.user_id', '=', user.id), ('doctor_id.mentor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('hr_hospital.group_hospital_doctor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hr_hospital_visit_manager_all" model="ir.rule">
            <field name="name">Hospital Visits: Manager All Visits</field>
            <field name="model_id" ref="model_hr_hospital_visit"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_hospital.group_hospital_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hr_hospital_visit_admin_all" model="ir.rule">
            <field name="name">Hospital Visits: Admin All Visits</field>
            <field name="model_id" ref="model_hr_hospital_visit"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_hospital.group_hospital_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
