<?xml version="1.0" encoding="utf-8"?>
<odoo>

	    <record id="view_hr_hospital_doctor_list" model="ir.ui.view">
	        <field name="name">hr.hospital.doctor.list</field>
	        <field name="model">hr.hospital.doctor</field>
	        <field name="arch" type="xml">
	            <list decoration-info="is_intern" sample="1">
	                <field name="photo" widget="image" class="oe_avatar" options="{'size': [32, 32]}"/>
	                <field name="name"/>
	                <field name="specialization"/>
	                <field name="category_id" widget="badge" decoration-success="category_id"/>
	                <field name="mentor_id" optional="show"/>
	                <field name="phone" class="o_force_ltr"/>
	                <field name="is_intern" widget="boolean_toggle"/>
	                <field name="gender" optional="hide"/>
	            </list>
	        </field>
	    </record>

	    <record id="action_hr_hospital_visit_create_quick_doctor" model="ir.actions.act_window">
	        <field name="name">Quick Visit</field>
	        <field name="res_model">hr.hospital.visit</field>
	        <field name="view_mode">form</field>
	        <field name="view_id" ref="view_hr_hospital_visit_form"/>
	        <field name="target">new</field>
	        <field name="context">{'default_doctor_id': active_id}</field>
	    </record>

	    <record id="view_hr_hospital_doctor_kanban" model="ir.ui.view">
	        <field name="name">hr.hospital.doctor.kanban</field>
	        <field name="model">hr.hospital.doctor</field>
	        <field name="arch" type="xml">
            <kanban highlight_color="color" default_group_by="category_id" class="o_kanban_small_column o_hospital_kanban_view" sample="1">
                <field name="name"/>
	                <field name="is_intern"/>
	                <field name="photo"/>
                <field name="specialization"/>
                <field name="intern_ids"/>
	                <templates>
                         <t t-name="menu">
                            <t t-if="widget.editable"><a role="menuitem" type="open" class="dropdown-item">Edit</a></t>
                            <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                            <div role="separator" class="dropdown-divider"></div>
                            <field name="color" widget="kanban_color_picker"/>
                        </t>
	                    <t t-name="card">
	                        <div t-attf-class="o_hospital_kanban_card oe_kanban_global_click shadow-sm border-0 rounded d-flex flex-column align-items-center text-center position-relative">
                                <div class="o_hospital_kanban_card_image o_kanban_image_full">
	                                <field name="photo" widget="image" options="{'preview_image': 'photo'}" class="w-100 h-100"/>
	                            </div>
                            <div class="o_hospital_kanban_card_body px-3 pb-3 pt-2 d-flex flex-column align-items-center">
                                <div class="d-flex flex-column align-items-center gap-1 w-100">
                                    <strong class="o_kanban_record_title o_hospital_kanban_title mb-0">
                                        <field name="name"/>
                                    </strong>
                                    <span t-if="record.is_intern.raw_value" class="badge rounded-pill bg-info text-white align-self-center">Intern</span>
                                    <span t-else="" class="o_hospital_kanban_badge_placeholder"/>
                                </div>
                                <div class="o_hospital_kanban_meta text-muted small mt-2">
                                    <i class="fa fa-stethoscope me-1"/> <field name="specialization"/>
                                </div>
                                <div t-if="record.intern_ids.raw_value and record.intern_ids.raw_value.length" class="o_hospital_kanban_interns mt-2 w-100">
                                    <div class="small fw-bold text-muted mb-1">Interns</div>
                                    <div class="small">
                                        <field name="intern_ids"/>
                                    </div>
                                </div>
                                <div class="mt-3 w-100">
                                    <button name="%(action_hr_hospital_visit_create_quick_doctor)d"
                                            type="action"
                                            class="btn btn-primary btn-sm w-100 rounded-pill shadow-sm">
                                        <i class="fa fa-calendar-plus-o me-1"/> Quick Visit
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hr_hospital_doctor_form" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.form</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(hr_hospital.action_hr_hospital_doctor_report_pdf)d"
                            string="Doctor Report (PDF)" type="action" class="btn-secondary"/>
                    <button name="%(hr_hospital.action_disease_report_wizard_binding)d"
                            string="Disease Report (PDF)" type="action" class="btn-secondary"/>
                    <button name="%(hr_hospital.action_hr_hospital_disease_month_report_wizard)d"
                            string="Disease Month Report" type="action" class="btn-primary shadow-sm"/>
                    <button name="%(hr_hospital.action_visit_report_wizard)d"
                            string="Visit Report" type="action" class="btn-primary shadow-sm"/>
                </header>
                <sheet>
                    <div class="d-flex align-items-start gap-4 mb-4">
                        <field name="photo" widget="image" class="oe_avatar shadow rounded" options="{'size': [120, 120]}"/>
                        <div class="oe_title flex-grow-1">
                            <label for="name" class="text-muted small fw-bold text-uppercase"/>
                            <h1 class="display-6 fw-bold"><field name="name" placeholder="Dr. Gregory House"/></h1>
                            <div class="d-flex gap-2">
                                <field name="category_id" options="{'no_create': True}" class="fw-bold"/>
                                <span class="text-muted">|</span>
                                <field name="specialization" class="text-primary"/>
                            </div>
                        </div>
                    </div>

                    <group>
                        <group string="Professional Context" name="pro_info">
                            <field name="is_intern" widget="boolean_toggle"/>
                            <field name="mentor_id"
                                   invisible="not is_intern"
                                   required="is_intern"
                                   options="{'no_create': True}"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group string="Contact Details" name="personal_info">
                            <field name="phone" widget="phone" click_to_call="1"/>
                            <field name="email" widget="email"/>
                            <field name="gender" widget="radio" options="{'horizontal': true}"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="General Info" name="medical_personal">
                            <group>
                                <group string="Medical Details">
                                    <field name="blood_group"/>
                                    <field name="rh_factor"/>
                                </group>
                                <group string="Demographics">
                                    <field name="date_of_birth"/>
                                    <field name="age"/>
                                </group>
                            </group>
                        </page>
                        <page string="Interns Team" name="interns" invisible="is_intern">
	                            <field name="intern_ids" mode="kanban">
	                                <kanban>
	                                    <templates>
	                                        <t t-name="card">
	                                            <div class="oe_kanban_global_click d-flex align-items-center p-2 border rounded shadow-sm">
	                                                <field name="photo" widget="image" class="oe_avatar me-2" style="max-width: 40px;"/>
	                                                <div>
	                                                    <strong class="d-block"><field name="name"/></strong>
                                                    <small class="text-muted"><field name="specialization"/></small>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_hospital_doctor_search" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.search</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
	            <search>
	                <field name="name"/>
	                <field name="specialization"/>
	                <field name="category_id"/>
	                <filter string="Mentors" name="filter_mentors" domain="[('is_intern', '=', False)]"/>
	                <filter string="Interns" name="filter_interns" domain="[('is_intern', '=', True)]"/>
	                <group>
	                    <filter string="Category" name="group_by_category" context="{'group_by': 'category_id'}"/>
	                    <filter string="Mentor" name="group_by_mentor" context="{'group_by': 'mentor_id'}"/>
	                </group>
	            </search>
	        </field>
	    </record>

	    <record id="action_hr_hospital_doctor" model="ir.actions.act_window">
	        <field name="name">Doctors</field>
	        <field name="res_model">hr.hospital.doctor</field>
	        <field name="view_mode">kanban,list,form</field>
	        <field name="search_view_id" ref="view_hr_hospital_doctor_search"/>
	        <field name="help" type="html">
	            <p class="o_view_nocontent_smiling_face">
	                Create your first doctor!
	            </p>
	        </field>
	    </record>

	</odoo>
