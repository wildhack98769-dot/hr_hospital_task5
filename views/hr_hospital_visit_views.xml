<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_hr_hospital_visit_kanban" model="ir.ui.view">
            <field name="name">hr.hospital.visit.kanban</field>
            <field name="model">hr.hospital.visit</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" quick_create="false" sample="1">
                    <field name="state"/>
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
	                    <field name="planned_date"/>
	                    <templates>
	                        <t t-name="card">
	                            <div t-attf-class="oe_kanban_global_click shadow-sm border-0 rounded p-3 mb-2">
	                                <div class="d-flex justify-content-between align-items-start">
	                                    <strong class="o_kanban_record_title text-primary fs-5">
	                                        <field name="patient_id"/>
	                                    </strong>
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'planned': 'info', 'done': 'success', 'cancelled': 'danger'}}"/>
                                </div>
                                <div class="mt-2 text-muted">
                                    <i class="fa fa-user-md me-1"/> <field name="doctor_id"/>
                                </div>
                                <div class="mt-1 small fw-bold text-dark">
                                    <i class="fa fa-calendar me-1"/> <field name="planned_date"/>
                                </div>
                                <div class="mt-2 border-top pt-2 text-truncate text-muted fst-italic" t-if="record.disease_id.raw_value">
                                    <i class="fa fa-stethoscope me-1"/> <field name="disease_id"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_hr_hospital_visit_form" model="ir.ui.view">
            <field name="name">hr.hospital.visit.form</field>
            <field name="model">hr.hospital.visit</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_done" string="Complete Visit" type="object"
                                class="btn-success" invisible="state != 'planned'"/>
                        <button name="action_cancel" string="Cancel" type="object"
                                class="btn-secondary" invisible="state == 'cancelled'"/>
                        <button name="action_planned" string="Planned" type="object"
                                class="btn-primary" invisible="state != 'cancelled'"/>
                        <button name="%(hr_hospital.action_disease_report_wizard_binding)d"
                                string="Disease Report (PDF)" type="action" class="oe_highlight"/>
                        <button name="%(hr_hospital.action_visit_report_wizard)d"
                                string="Visit Report" type="action" class="oe_highlight"/>

                        <field name="state" widget="statusbar" statusbar_visible="planned,done,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_same_disease_visits"
                                    type="object" class="oe_stat_button"
                                    icon="fa-history"
                                    invisible="not disease_id">
                                <field name="same_disease_visit_count" widget="statinfo" string="Similar Cases"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name" string="Visit #"/>
                            <h1><field name="name" readonly="1" class="text-primary"/></h1>
                        </div>
                        <group>
                            <group string="Medical Team">
                                <field name="patient_id" options="{'no_create': True}"/>
                                <field name="doctor_id" options="{'no_create': True}"/>
                                <field name="disease_id"
                                       options="{'no_create': True}"
                                       domain="[('is_group', '=', False)]"
                                       context="{'search_default_filter_is_not_group': 1}"/>
                            </group>
                            <group string="Time and Status">
                                <field name="planned_date"/>
                                <field name="actual_date" readonly="state == 'done'"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Summary and Treatment" name="medical_details">
                                <field name="summary" widget="html" placeholder="Describe symptoms, diagnosis, and treatment plan..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_hr_hospital_visit_list" model="ir.ui.view">
            <field name="name">hr.hospital.visit.list</field>
            <field name="model">hr.hospital.visit</field>
            <field name="arch" type="xml">
                <list decoration-info="state == 'planned'" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'">
                    <field name="name"/>
                    <field name="planned_date"/>
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <field name="disease_id"/>
                    <field name="state" widget="badge" decoration-info="state == 'planned'" decoration-success="state == 'done'"/>
                </list>
            </field>
        </record>

        <record id="view_hr_hospital_visit_calendar" model="ir.ui.view">
            <field name="name">hr.hospital.visit.calendar</field>
            <field name="model">hr.hospital.visit</field>
            <field name="arch" type="xml">
                <calendar string="Visit Calendar" date_start="planned_date" color="doctor_id" mode="month">
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <field name="state"/>
                </calendar>
            </field>
        </record>

	        <record id="view_hr_hospital_visit_search" model="ir.ui.view">
	            <field name="name">hr.hospital.visit.search</field>
	            <field name="model">hr.hospital.visit</field>
	            <field name="arch" type="xml">
	                <search>
	                    <field name="name"/>
	                    <field name="patient_id"/>
	                    <field name="doctor_id"/>
	                    <field name="disease_id"/>

	                    <filter string="Current Year" name="current_year"
	                            domain="[('planned_date', '&gt;=', datetime.datetime(context_today().year, 1, 1)),
	                                    ('planned_date', '&lt;', datetime.datetime(context_today().year + 1, 1, 1))]"/>
	                    <separator/>
	                    <filter string="Planned" name="filter_planned" domain="[('state', '=', 'planned')]"/>
	                    <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
	                    <separator/>
	                    <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>

	                    <group>
	                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
	                        <filter string="Doctor" name="group_by_doctor" context="{'group_by': 'doctor_id'}"/>
	                    </group>

	                    <searchpanel>
	                        <field name="doctor_id" enable_counters="1" select="multi" expand="1"/>
	                    </searchpanel>
	                </search>
	            </field>
	        </record>

	        <record id="view_hr_hospital_visit_pivot" model="ir.ui.view">
	            <field name="name">hr.hospital.visit.pivot</field>
	            <field name="model">hr.hospital.visit</field>
	            <field name="arch" type="xml">
	                <pivot string="Visits Analysis">
	                    <field name="doctor_id" type="row"/>
	                    <field name="planned_date" type="col" interval="month"/>
	                    <field name="state" type="col"/>
	                </pivot>
	            </field>
	        </record>

	        <record id="view_hr_hospital_visit_graph" model="ir.ui.view">
	            <field name="name">hr.hospital.visit.graph</field>
	            <field name="model">hr.hospital.visit</field>
	            <field name="arch" type="xml">
	                <graph string="Visits Analysis" type="bar" stacked="1">
	                    <field name="planned_date" type="row" interval="month"/>
	                    <field name="disease_id" type="col"/>
	                </graph>
	            </field>
	        </record>

	        <record id="action_hr_hospital_visit" model="ir.actions.act_window">
	            <field name="name">Visits</field>
	            <field name="res_model">hr.hospital.visit</field>
	            <field name="view_mode">kanban,list,form,calendar,pivot,graph</field>
	            <field name="search_view_id" ref="view_hr_hospital_visit_search"/>
	            <field name="help" type="html">
	                <p class="o_view_nocontent_smiling_face">
	                    Time to schedule a new visit!
	                </p>
	            </field>
	        </record>

	        <record id="action_hr_hospital_visit_analysis" model="ir.actions.act_window">
	            <field name="name">Visits Analysis</field>
	            <field name="res_model">hr.hospital.visit</field>
	            <field name="view_mode">pivot,graph</field>
	            <field name="search_view_id" ref="view_hr_hospital_visit_search"/>
	            <field name="context">{'search_default_current_year': 1}</field>
	        </record>

	    </data>
	</odoo>
