<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hr_hospital_patient_kanban" model="ir.ui.view">
            <field name="name">hr.hospital.patient.kanban</field>
            <field name="model">hr.hospital.patient</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_small_column o_hospital_kanban_view" sample="1">
                    <field name="name"/>
                    <field name="photo"/>
                    <field name="age"/>
                    <field name="phone"/>
	                    <field name="blood_group"/>
	                    <templates>
	                        <t t-name="card">
	                            <div t-attf-class="o_hospital_kanban_card oe_kanban_global_click shadow-sm border-0 rounded d-flex flex-column align-items-center text-center">
	                                <div class="o_hospital_kanban_card_image o_kanban_image_full">
	                                    <field name="photo" widget="image" options="{'preview_image': 'photo'}" class="w-100 h-100"/>
	                                </div>
                                <div class="o_hospital_kanban_card_body px-3 pb-3 pt-2 d-flex flex-column align-items-center">
                                    <div class="d-flex flex-column align-items-center gap-1 w-100">
                                        <strong class="o_kanban_record_title o_hospital_kanban_title mb-0">
                                            <field name="name"/>
                                        </strong>
                                        <span class="o_hospital_kanban_badge_placeholder"/>
                                    </div>
                                    <div class="o_hospital_kanban_meta text-muted small mt-2">
                                        <span t-if="record.age.raw_value"><field name="age"/> years | </span>
                                        <field name="blood_group"/>
                                    </div>
                                    <div class="mt-3" t-if="record.phone.raw_value">
                                        <a t-attf-href="tel:#{record.phone.raw_value}" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            <i class="fa fa-phone me-1"/> Call
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_hr_hospital_patient_list" model="ir.ui.view">
            <field name="name">hr.hospital.patient.list</field>
            <field name="model">hr.hospital.patient</field>
            <field name="arch" type="xml">
                <list sample="1">
                    <field name="photo" widget="image" class="oe_avatar" options="{'size': [32, 32]}"/>
                    <field name="name"/>
                    <field name="date_of_birth" optional="show"/>
                    <field name="age" optional="show"/>
                    <field name="gender" widget="badge" decoration-info="gender == 'male'" decoration-danger="gender == 'female'"/>
                    <field name="phone" widget="phone"/>
                    <field name="blood_group" optional="show"/>
                    <field name="personal_doctor_id" widget="many2one_avatar"/>
                    <field name="insurance_policy" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_hr_hospital_patient_form" model="ir.ui.view">
            <field name="name">hr.hospital.patient.form</field>
            <field name="model">hr.hospital.patient</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_create_visit" string="Quick Visit" type="object" class="btn-primary shadow-sm"/>
                        <button name="action_open_patient_visits" string="Visit History" type="object" class="btn-secondary"/>
                    </header>
                    <sheet>
                        <div class="d-flex align-items-start gap-4 mb-4">
                            <field name="photo" widget="image" class="oe_avatar shadow rounded" options="{'size': [120, 120]}"/>
                            <div class="oe_title flex-grow-1">
                                <label for="name" class="text-muted small fw-bold text-uppercase"/>
                                <h1 class="display-6 fw-bold"><field name="name" placeholder="e.g. John Doe"/></h1>
                                <div class="d-flex gap-2">
                                        <field name="gender" widget="radio" options="{'horizontal': true}"/>
                                </div>
                            </div>
                        </div>

                        <group>
                            <group string="Medical Data" name="medical_data">
                                <field name="date_of_birth"/>
                                <field name="age" class="fw-bold"/>
                                <label for="blood_group" string="Blood Details"/>
                                <div class="d-flex gap-2">
                                    <field name="blood_group" placeholder="Group"/>
                                    <field name="rh_factor" placeholder="Rh"/>
                                </div>
                                <field name="personal_doctor_id" widget="many2one_avatar" options="{'no_create': True}"/>
                            </group>
                            <group string="Contact &amp; Insurance" name="contact_data">
                                <field name="phone" widget="phone" click_to_call="1"/>
                                <field name="email" widget="email"/>
                                <field name="insurance_policy" placeholder="Policy Number..."/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Doctor History" name="doctor_history">
                                <field name="doctor_history_ids" readonly="1">
                                    <list decoration-muted="not active">
                                        <field name="doctor_id" widget="many2one_avatar"/>
                                        <field name="appointment_date" widget="date"/>
                                        <field name="change_date" widget="datetime"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_hr_hospital_patient_search" model="ir.ui.view">
            <field name="name">hr.hospital.patient.search</field>
            <field name="model">hr.hospital.patient</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="Patient Name" filter_domain="['|', ('name', 'ilike', self), ('phone', 'ilike', self)]"/>
                    <field name="phone"/>
                    <field name="personal_doctor_id"/>
                    <separator/>
                    <filter string="Male" name="male" domain="[('gender', '=', 'male')]"/>
                    <filter string="Female" name="female" domain="[('gender', '=', 'female')]"/>
                    <group>
                        <filter string="Doctor" name="group_by_doctor" context="{'group_by': 'personal_doctor_id'}"/>
                        <filter string="Blood Group" name="group_by_blood" context="{'group_by': 'blood_group'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_hr_hospital_patient" model="ir.actions.act_window">
            <field name="name">Patients</field>
            <field name="res_model">hr.hospital.patient</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_hr_hospital_patient_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Register your first patient
                </p>
            </field>
        </record>
    </data>
</odoo>
