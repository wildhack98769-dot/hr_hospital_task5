<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_hr_hospital_disease_search" model="ir.ui.view">
            <field name="name">hr.hospital.disease.search</field>
            <field name="model">hr.hospital.disease</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="parent_id"/>
                    <filter string="Diseases" name="filter_is_not_group" domain="[('is_group', '=', False)]"/>
                    <filter string="Groups" name="filter_is_group" domain="[('is_group', '=', True)]"/>

                    <group>
                        <filter string="Parent Category" name="group_by_parent" context="{'group_by': 'parent_id'}"/>
                    </group>

                    <searchpanel>
                        <field name="parent_id" string="Hierarchy" hierarchize="1" enable_counters="1" select="multi"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="view_hr_hospital_disease_kanban" model="ir.ui.view">
            <field name="name">hr.hospital.disease.kanban</field>
            <field name="model">hr.hospital.disease</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_small_column o_hospital_kanban_view o_hospital_disease_kanban_view" sample="1">
                    <field name="name"/>
                    <field name="is_group"/>
	                    <field name="parent_id"/>
	                    <templates>
	                        <t t-name="card">
	                            <div t-attf-class="o_hospital_kanban_card oe_kanban_global_click shadow-sm border-0 rounded d-flex flex-column align-items-center text-center position-relative">
	                                <div class="o_hospital_disease_kanban_icon d-flex align-items-center justify-content-center">
	                                    <i t-if="record.is_group.raw_value" class="fa fa-folder text-warning"/>
                                        <i t-else="" class="fa fa-bug text-danger"/>
                                    </div>
                                    <div class="o_hospital_kanban_card_body px-3 pb-3 pt-2 d-flex flex-column align-items-center">
                                        <strong class="o_kanban_record_title o_hospital_kanban_title mb-0">
                                            <field name="name"/>
                                        </strong>
                                        <span t-if="record.is_group.raw_value" class="badge rounded-pill bg-warning text-dark mt-2">Group</span>
                                        <span t-else="" class="badge rounded-pill bg-danger text-white mt-2">Disease</span>
                                        <div t-if="record.parent_id.value" class="text-muted small mt-2">
                                            <i class="fa fa-level-up me-1"/> <field name="parent_id"/>
                                        </div>
                                    </div>
                                </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_hr_hospital_disease_list" model="ir.ui.view">
            <field name="name">hr.hospital.disease.list</field>
            <field name="model">hr.hospital.disease</field>
            <field name="arch" type="xml">
                <list decoration-bf="is_group" decoration-warning="is_group" sample="1">
                    <field name="name"/>
                    <field name="parent_id" optional="show"/>
                    <field name="is_group" widget="boolean_toggle" optional="show"/>
                    <field name="description" optional="hide"/>
                    <field name="parent_path" column_invisible="True"/>
                </list>
            </field>
        </record>

        <record id="view_hr_hospital_disease_form" model="ir.ui.view">
            <field name="name">hr.hospital.disease.form</field>
            <field name="model">hr.hospital.disease</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Disease Name"/>
                            <h1><field name="name" placeholder="e.g. Type 2 Diabetes"/></h1>
                        </div>
                        <group>
                            <group name="main_details">
                                <field name="is_group" widget="boolean_toggle"/>
                                <field name="parent_id"
                                       string="Parent Category"
                                       options="{'no_create': True, 'no_open': True}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Medical Description" name="description">
                                <field name="description" widget="html"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hr_hospital_disease" model="ir.actions.act_window">
            <field name="name">Diseases</field>
            <field name="res_model">hr.hospital.disease</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_hr_hospital_disease_search"/>
            <field name="context">{'search_default_filter_is_not_group': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add a new disease or category
                </p>
            </field>
        </record>

    </data>
</odoo>
